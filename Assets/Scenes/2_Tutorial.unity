  m_GameObject: {fileID: 1516051611}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf5d6166e4813934ea2b5ff022c54f1a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialSteps
  player: {fileID: 2104497941}
  vehicle: {fileID: 605385038}
  stepText: {fileID: 762957588}
  steps:
  - text: "\xA1Bienvenido! Unas frutas se escaparon y debes atraparlas con el carro."
    condition: 0
    value: 4
  - text: Mueve el mouse para mirar a tu alrededor.
    condition: 1
    value: 45
  - text: Camina con W A S D.
    condition: 2
    value: 2
  - text: "Ac\xE9rcate al carro, m\xEDralo y presiona E para subirte."
    condition: 3
    value: 3
  - text: "Gira el tim\xF3n para dirigir el carro a los lados.\n(Teclado: A / D)"
    condition: 4
    value: 0.5
  - text: 'Usa el acelerador para avanzar.

      (Teclado: W)'
    condition: 5
    value: 1
  - text: "Usa el freno para detenerte. Si ya est\xE1s detenido, el freno te da reversa.\n(Teclado:
      S)"
    condition: 6
    value: 1
  - text: "Cambia la vista de la c\xE1mara con el bot\xF3n CICLO.\n(Teclado: V)"
    condition: 7
    value: 3
  finalMessage: "\xA1Ahora int\xE9ntalo! Atrapa la fruta que est\xE1 en el escenario."
